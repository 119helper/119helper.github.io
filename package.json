{
  "name": "119-helper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm --prefix worker run dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:unit": "vitest run src",
    "test:worker": "vitest run worker/src",
    "audit:regions": "node scripts/audit-administrative-regions.js",
    "audit:data-freshness": "node scripts/audit-official-data-freshness.mjs",
    "sync:fire-stats": "node scripts/sync-nfds-fire-stats.mjs",
    "sync:firewater-overlays": "node scripts/sync-firewater-regional-overlays.mjs",
    "audit:tsunami-public": "node scripts/tsunami-public-crosscheck.mjs",
    "test:data-scripts": "node --test scripts/*.test.mjs",
    "test:e2e": "npm run test:e2e:ui && npm run test:e2e:offline",
    "test:e2e:ui": "playwright test --config=playwright.config.ts",
    "test:e2e:offline": "playwright test --config=playwright.offline.config.ts"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.8",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.35.0",
    "proj4": "^2.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shpjs": "^6.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.3.0",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
