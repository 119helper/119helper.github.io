{
  "name": "119-helper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm --prefix worker run dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:unit": "vitest run src",
    "test:worker": "vitest run worker/src",
    "audit:regions": "node scripts/audit-administrative-regions.js",
    "audit:data-freshness": "node scripts/audit-official-data-freshness.mjs",
    "test:e2e": "npm run test:e2e:ui && npm run test:e2e:offline",
    "test:e2e:ui": "playwright test --config=playwright.config.ts",
    "test:e2e:offline": "playwright test --config=playwright.offline.config.ts"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.8",
    "idb-keyval": "^6.2.5",
    "lucide-react": "^1.8.0",
    "proj4": "^2.20.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.8"
  }
}
