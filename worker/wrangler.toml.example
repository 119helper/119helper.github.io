# 119 Helper Worker 셀프 배포 가이드
# 이 파일을 wrangler.toml로 복사하고 수정하세요.

name = "119-helper-api"
main = "src/index.ts"
compatibility_date = "2025-03-01"

# account_id = "YOUR_CF_ACCOUNT_ID"  # ← 본인 CF 계정 ID

[vars]
ENVIRONMENT = "production"

# ─── 분산 Rate Limiting (in-memory Map 대체) ───
# isolate/PoP마다 따로 세던 기존 방식과 달리 colo 단위로 일관되게 제한한다.
# ⚠️ colo(지역) 단위라 글로벌 하드캡은 아님 — 분산 공격까지 막으려면
#    Cloudflare 대시보드의 WAF Rate Limiting Rules / Turnstile을 추가로 설정할 것.
[[unsafe.bindings]]
name = "RATE_LIMITER"
type = "ratelimit"
namespace_id = "1001"            # 계정 내 임의 고유 ID
simple = { limit = 60, period = 60 }   # 60초당 60회

# 뉴스 RSS 캐시 및 실패 시 stale fallback용 KV namespace.
# GitHub Actions 배포에서는 NEWS_CACHE_KV_ID / NEWS_CACHE_KV_PREVIEW_ID secret으로
# CI용 wrangler 설정 파일을 생성한다.
[[kv_namespaces]]
binding = "NEWS_CACHE"
id = "YOUR_NEWS_CACHE_KV_NAMESPACE_ID"
preview_id = "YOUR_NEWS_CACHE_KV_PREVIEW_NAMESPACE_ID"

[triggers]
crons = ["*/30 * * * *"]

# API 키는 시크릿으로 등록:
# wrangler secret put KMA_API_KEY
# wrangler secret put ER_API_KEY
# wrangler secret put AIR_API_KEY
# wrangler secret put BUILDING_API_KEY
# wrangler secret put FIRE_WATER_API_KEY
# wrangler secret put HOLIDAY_API_KEY
# wrangler secret put KAKAO_MAP_KEY
# wrangler secret put MULTI_USE_API_KEY
# wrangler secret put SHELTER_API_KEY
# wrangler secret put EMERGENCY_API_KEY
# wrangler secret put FIRE_INFO_API_KEY
# wrangler secret put ANNUAL_FIRE_API_KEY
# wrangler secret put FIRE_OBJECT_API_KEY
# wrangler secret put FIRE_DAMAGE_API_KEY
# wrangler secret put WILDFIRE_API_KEY
# wrangler secret put CIVIL_SHELTER_API_KEY
# wrangler secret put FOREST_FIRE_API_KEY
# wrangler secret put TSUNAMI_SHELTER_API_KEY
# wrangler secret put DISASTER_API_KEY
# wrangler secret put EQUIPMENT_API_KEY
# wrangler secret put CONSUMER_HAZARD_API_KEY
# wrangler secret put AMBULANCE_API_KEY
#
# 심층 방어용 공유 앱 토큰 (운영 필수). 프론트엔드 VITE_APP_TOKEN과 동일하게 맞춰야 함:
# wrangler secret put APP_ACCESS_TOKEN
