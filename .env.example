# 119 Helper frontend env
# Vite는 ../key/119-helper/.env 에서 이 값을 읽습니다.
# ──────────────────────────────────

# 카카오맵 JavaScript API (developers.kakao.com)
VITE_KAKAO_MAP_KEY=your_kakao_map_key_here

# Worker API 베이스 URL (미설정 시 기본 프로덕션 Worker 사용)
# VITE_API_BASE=https://119-helper-api.your-account.workers.dev
# 로컬 Worker를 함께 띄울 때만 사용:
# VITE_API_BASE=http://localhost:8787

# 심층 방어용 공유 앱 토큰 (선택). Worker의 APP_ACCESS_TOKEN과 동일해야 함.
# 미설정 시 토큰 검사를 생략한다(하위 호환).
# VITE_APP_TOKEN=your_shared_app_token_here

# 공중화장실 정적 데이터 동기화 스크립트용 (scripts/sync-restrooms.js)
# 브라우저 번들에 넣지 않는 서버/로컬 실행용 키이므로 VITE_ 접두사를 쓰지 않는다.
RESTROOM_API_KEY=your_restroom_api_key_here

# ──────────────────────────────────
# 공공데이터 API 키는 프론트엔드 .env가 아니라 Worker secret으로 등록하세요.
# 예: cd worker && wrangler secret put KMA_API_KEY
# 전체 목록은 worker/wrangler.toml.example 참고.
# ──────────────────────────────────
